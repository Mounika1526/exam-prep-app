generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_IN_BLANK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AiRole {
  USER
  ASSISTANT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(STUDENT)
  avatar      String?
  targetExam  String?
  examDate    DateTime?
  hoursPerDay Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  testSessions     TestSession[]
  userProgress     UserProgress[]
  studySessions    StudySession[]
  streak           Streak?
  aiConversations  AiConversation[]
  aiSuggestions    AiSuggestion[]
  aiStudyPlans     AiStudyPlan[]
  aiSavedQuestions AiSavedQuestion[]
  questions        Question[]        @relation("CreatedBy")
  refreshTokens    RefreshToken[]
  otpTokens        OtpToken[]

  @@map("users")
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects        Subject[]
  questions       Question[]
  testSessions    TestSession[]
  aiSuggestions   AiSuggestion[]
  aiStudyPlans    AiStudyPlan[]
  aiConversations AiConversation[]

  @@map("exams")
}

model Subject {
  id        String   @id @default(cuid())
  examId    String
  title     String
  order     Int      @default(0)
  icon      String?
  createdAt DateTime @default(now())

  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  questions     Question[]
  studySessions StudySession[]

  @@map("subjects")
}

model Chapter {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  order       Int      @default(0)
  description String?
  createdAt   DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@map("chapters")
}

model Topic {
  id            String   @id @default(cuid())
  chapterId     String
  title         String
  content       String?  @db.Text
  resources     Json?
  videoUrl      String?
  order         Int      @default(0)
  estimatedMins Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions        Question[]
  userProgress     UserProgress[]
  aiConversations  AiConversation[]
  aiSavedQuestions AiSavedQuestion[]

  @@map("topics")
}

model Question {
  id          String       @id @default(cuid())
  topicId     String?
  subjectId   String?
  examId      String?
  text        String       @db.Text
  type        QuestionType @default(MCQ)
  options     Json?
  answer      String
  explanation String?      @db.Text
  difficulty  Difficulty   @default(MEDIUM)
  tags        String[]
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  exam        Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  creator     User?        @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  testAnswers TestAnswer[]

  @@map("questions")
}

model TestSession {
  id             String     @id @default(cuid())
  userId         String
  examId         String
  startedAt      DateTime   @default(now())
  submittedAt    DateTime?
  totalQuestions Int
  score          Float?
  timeTakenSecs  Int?
  status         TestStatus @default(IN_PROGRESS)
  timeLimitMins  Int?                        // optional countdown timer
  questionIds    String[]   @default([])     // ordered list of question IDs for this session

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  testAnswers     TestAnswer[]
  aiConversations AiConversation[]

  @@index([userId])
  @@index([examId])
  @@index([userId, status])
  @@map("test_sessions")
}

model TestAnswer {
  id             String  @id @default(cuid())
  sessionId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  timeTakenSecs  Int?

  session  TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("test_answers")
}

model UserProgress {
  id        String         @id @default(cuid())
  userId    String
  topicId   String
  status    ProgressStatus @default(NOT_STARTED)
  notes     String?        @db.Text
  updatedAt DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, status])
  @@map("user_progress")
}

model StudySession {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String
  date         DateTime @default(now())
  durationMins Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_sessions")
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  examId    String?
  sessionId String?
  role      AiRole
  message   String   @db.Text
  timestamp DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  exam    Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  session TestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, topicId])
  @@map("ai_conversations")
}

model AiSuggestion {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  suggestions Json
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, examId])
  @@map("ai_suggestions")
}

model AiStudyPlan {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  examDate    DateTime
  hoursPerDay Float
  plan        Json
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("ai_study_plans")
}

model AiSavedQuestion {
  id          String     @id @default(cuid())
  userId      String
  topicId     String?
  question    String     @db.Text
  options     Json?
  answer      String
  explanation String?    @db.Text
  difficulty  Difficulty @default(MEDIUM)
  createdAt   DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("ai_saved_questions")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  otp       String   // bcrypt hash of the 6-digit code
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_tokens")
}
